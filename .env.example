# Copy to .env (both builds read it) and fill in from Supabase: Project Settings → API Keys.
# These two are public by design (row-level security protects the data). NEVER put a
# secret key (sb_secret_…) or the service_role key here or anywhere in the game.
# (A legacy anon key works too, as VITE_SUPABASE_ANON_KEY.)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
